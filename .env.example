# --- Ollama / LLM ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b  # deprecated: kept for compatibility, falls back into DEEP_MODEL if unset
DATABASE_PATH=data/jarvis.db

# --- Model mode: only one model is ever resident in Ollama at a time (see README "Model mode") ---
# LIGHT and BALANCED use locally registered models: see README "Model mode" for how to build them
# BALANCED uses a locally converted model: see README "Model mode" for how to build qwen3-heretic:8b
# MODEL_MODE=deep          # deep (default), balanced or light - which mode starts on launch
# LIGHT_MODEL=qwen3-heretic:4b
# BALANCED_MODEL=qwen3-heretic:8b
# DEEP_MODEL=qwen3:8b
# LIGHT_VOICE_NUM_PREDICT=200
# DEEP_THINK=true           # DEEP's chat replies reason first (better answers, slower); LIGHT/BALANCED never do
#
# Zira talks first: in hands-free (Continuous) voice mode, after a random quiet spell she starts the
# conversation herself (a question to learn about you, a compliment, or a fun point about your interests).
# PROACTIVE_ENABLED=true
# PROACTIVE_MIN_MINUTES=4
# PROACTIVE_MAX_MINUTES=10
# PROACTIVE_MAX_UNANSWERED=2   # stop after this many openers in a row get no answer (until you speak)

# --- Server (keep on 127.0.0.1; do NOT expose publicly) ---
HOST=127.0.0.1
PORT=8000

# --- Optional tuning ---
# Human-friendly model name shown in the UI (derived from OLLAMA_MODEL if unset)
# MODEL_LABEL=Qwen3 8B
# OLLAMA_NUM_CTX=8192
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_TIMEOUT=120
# Qwen3 "thinking" mode. false = faster replies, no <think> blocks.
# OLLAMA_THINK=false

# --- Personality (configurable, never put personal info here) ---
# ASSISTANT_NAME=Zira   # the persona's name; the wake word is "Hello <name>" (see STT_INITIAL_PROMPT)
# PERSONALITY_STYLE=excited, warm, playful, confident, honest
# PERSONALITY_EXTRA=

# --- Automatic memory (the LLM saves durable facts you state, e.g. "my name is ...") ---
# AUTO_MEMORY=true
# AUTO_MEMORY_MAX_ITEMS=3

# --- Web search (queries are sent to DuckDuckGo when Zira decides it needs the internet) ---
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT=8

# --- Project access (read-only, opt-in) ---
# Comma-separated absolute folders Zira may read (to explain code, scan APIs, make Postman collections).
# Secrets (.env, keystores, keys, google-services.json ...) are always blocked. Leave empty to disable.
# FILE_ACCESS_ROOTS=/Users/you/projects/my-app,/Users/you/projects/other
# Folders where Zira may PROPOSE code changes (Edit mode). Every change is shown as a diff and is
# applied only when you click Approve in the UI; each applied change can be undone.
# FILE_WRITE_ROOTS=/Users/you/projects/my-app
# FILE_READ_MAX_CHARS=5000
# EXPORTS_DIR=data/exports

# --- Voice (opt-in; both default to "unavailable" = voice mode hidden in the UI) ---
# Local, offline speech-to-text (Whisper). First use downloads the model once, then runs fully
# offline. Understands Hindi, English and mixed Hinglish. Two provider/engine choices:
#
# mlx-whisper (recommended on Apple Silicon): uses Apple's MLX framework, Metal-accelerated.
# STT_MODEL is a Hugging Face repo of MLX-converted weights. Measured for real on an M4: the same
# large-v3-turbo model that took ~23s/clip via faster-whisper (CPU-only, no Metal backend in
# CTranslate2) took ~4-5s/clip via mlx-whisper - about 5x faster for identical accuracy. See
# scripts/voice_benchmark.py and README "Voice" for the full comparison and real Hinglish results.
# STT_PROVIDER=mlx-whisper
# STT_MODEL=mlx-community/whisper-large-v3-turbo
#
# faster-whisper (CTranslate2, portable/CPU-only - use this on Intel Macs or if mlx-whisper doesn't
# work for you): STT_MODEL is tiny/base/small/medium/large-v3/large-v3-turbo.
# STT_PROVIDER=faster-whisper
# STT_MODEL=small
#
# Force a language (e.g. hi, en) only if auto-detect picks the wrong one for you; leave empty
# for auto-detect, which is usually the better default for code-switched Hinglish.
# STT_LANGUAGE=
# faster-whisper only: when STT_LANGUAGE is empty (auto-detect), restricts detection to just these
# languages instead of Whisper's full ~100-language space - unrestricted auto-detect can drift into
# acoustically similar languages (Urdu, Arabic sound close to Hindi) on short/accented clips with
# the smaller "small"/"medium" models. Comma-separated codes; picks whichever of these scores
# highest. Empty = no restriction. Not implemented for mlx-whisper (see its docstring in
# app/voice/speech_to_text.py for why, and why it's less needed with large-v3-turbo). See README
# "Voice".
# STT_LANGUAGE_CANDIDATES=hi,en
# mlx-whisper only: text Whisper is primed with before it decodes. The wake word is matched against
# the transcript, and Whisper spells a rare name many different ways; priming with "Hello <name>."
# makes it spell the name the way the matcher expects (measured - see README "Voice"). Unset = that
# default, built from ASSISTANT_NAME. Set your own text, or an empty value to turn priming off.
# STT_INITIAL_PROMPT=
# Local, offline text-to-speech using macOS's built-in `say`. TTS_VOICE must be an installed
# voice (list yours with `say -v ?`). Good options that ship on most Macs:
#   Rishi (English-India, male)   - default; reads romanized Hinglish well, cannot read Devanagari
#   Tara  (English-India, female)
#   Lekha (Hindi hi_IN, female)   - reads Devanagari well, garbles embedded Latin-script English
# say is a single monolingual voice per call, so it will not switch accent mid-sentence for
# genuinely code-switched Hinglish text - see README "Voice" for the honest, measured limitation.
# Kokoro TTS (recommended, 2026-09-28): Kokoro-82M runs locally in its own Python 3.11 environment and speaks a
# voice reply sentence by sentence while Qwen is still writing it. Install once:
#   /opt/homebrew/bin/python3.11 -m venv .venv-kokoro && .venv-kokoro/bin/pip install -r third_party/kokoro/requirements.txt
# Voices are Kokoro's own IDs: hf_alpha / hf_beta (Indian female), hm_omega / hm_psi (Indian male), af_heart
# (American female, Kokoro's best-rated), bf_emma (British female) ... - see third_party/kokoro/NOTICE.md.
# Hinglish chunks are spoken with Kokoro's Hindi G2P (Hindi words written in Devanagari first, English words
# kept); pure English chunks use KOKORO_LANG (a = American, b = British). The macOS `say` voice (TTS_VOICE)
# stays selectable in the UI as a local fallback.
# TTS_PROVIDER=kokoro
# KOKORO_VOICE=hf_alpha
# KOKORO_SPEED=1.0          # 0.8 slower ... 1.2 faster
# KOKORO_LANG=a
# KOKORO_DEVICE=cpu         # cpu keeps the Apple GPU free for Qwen; mps also works
# KOKORO_HINGLISH=true
# TTS_STREAMING=true        # false: speak the whole reply after it is written (the old way)
# TTS_MIN_CHUNK_LENGTH=20   # a shorter sentence is joined to the next one
# TTS_MAX_CHUNK_LENGTH=250  # a longer one is split at a comma or space
# TTS_FIRST_CHUNK_LENGTH=60 # the first chunk may end at a comma once this long, so audio starts sooner
#
# TTS_PROVIDER=say
# TTS_VOICE=Rishi
# TTS_RATE=0
#
# Optional second reply voice: IndicF5-Hinglish (see README "Optional voice: IndicF5-Hinglish"). Needs the
# separate .venv-tts environment and the model files; the UI then shows a RISHI / INDICF5 switch. Startup is
# always Rishi, and IndicF5 is only loaded while selected. Slow (10-20s of compute per second of speech).
# TTS_INDICF5_ENABLED=false
# TTS_INDICF5_VOICE=MAR_M_WIKI_00001   # any id in third_party/indicf5/voices/voices.json
# TTS_INDICF5_STEPS=16                 # 16 fast, 32 slower and a little cleaner
# VOICE_MAX_AUDIO_BYTES=15000000
# VOICE_MAX_SPEECH_CHARS=4000
# Fixes STT disfluencies (dropped words, run-ons, obvious mis-transcriptions) via an extra LLM
# call before the transcript becomes your chat message. Never translates/changes script/invents
# content; falls back to the raw transcript on any failure. On by default - see README "Voice".
# VOICE_TRANSCRIPT_CLEANUP_ENABLED=true
# VOICE_TRANSCRIPT_CLEANUP_TIMEOUT=12

# --- Context building ---
# CONTEXT_MAX_MESSAGES=20
# MEMORY_TOP_K=8
# MAX_MESSAGE_CHARS=8000

# --- Context-window checkpointing (data/checkpoints/<conversation_id>.md) ---
# Once a conversation's estimated token count reaches this fraction of OLLAMA_NUM_CTX, older
# history is compacted into a markdown summary so the chat/coding session can keep going instead
# of context silently overflowing or old messages being dropped unrecorded.
# CONTEXT_CHECKPOINT_ENABLED=true
# CONTEXT_CHECKPOINT_THRESHOLD=0.75
# CHECKPOINTS_DIR=data/checkpoints

# --- Self-learning (data: the `knowledge` table; see README "Self-learning") ---
# While idle, Zira researches one topic drawn from your long-term memory (projects, work,
# preferences - never personal/identity facts) and caches a summary locally, so a future question
# about it can be answered without searching again. On by default: unlike web_search, this contacts
# the internet on its own, on a timer, not from a live request you made. Set to false to disable.
# KNOWLEDGE_LEARNING_ENABLED=true
# KNOWLEDGE_IDLE_MINUTES=15
# KNOWLEDGE_RESEARCH_COOLDOWN_MINUTES=60
# KNOWLEDGE_TOPIC_COOLDOWN_DAYS=7
# KNOWLEDGE_MAX_RESULTS_PER_TOPIC=4
# KNOWLEDGE_CONTEXT_TOP_K=3

# --- Music player (your own library only - no external catalog search; see README "Music") ---
# Leave both empty to keep this off entirely (no tools registered, no player panel shown).
# Local folder(s) Zira may search for songs (comma-separated), sandboxed like project files.
# MUSIC_LIBRARY_ROOTS=/Users/you/Music/MyLibrary
# URL to a JSON index of tracks you host yourself: [{"title","artist","url"}, ...]. Checked only
# if nothing matches locally.
# MUSIC_REMOTE_INDEX_URL=
# MUSIC_REMOTE_INDEX_CACHE_SECONDS=300

# --- Image generation (local, offline, Apple Silicon via diffusers - see README "Image generation") ---
# Off by default: needs a real model download (~6.9GB per style) and meaningful
# compute/memory per image, unlike the other tools - deliberately NOT in requirements.txt for the
# same reason. Run `pip install diffusers accelerate` yourself first, then set this.
# IMAGE_GENERATION_ENABLED=true
# IMAGE_GENERATION_TIMEOUT=1200
#
# Image style - REALISTIC (Perfection Realistic ILXL, an SDXL/Illustrious XL photorealism checkpoint),
# LIGHTNING (RealVisXL V4.0 Lightning, few-step) or REALVIS5 (RealVisXL V5.0, full model) - only one loaded in
# memory at a time, switchable at runtime from the UI with no restart. All ungated SDXL models, no Hugging Face
# account/token needed, and edit_image works with each. (FLUX.2 Klein 4B was removed 2026-09-28; ANIME/Pony
# Diffusion V6 XL was removed earlier after real quality failures - see README.)
# IMAGE_STYLE=none         # none | realistic | lightning | realvis5
# The default, "none", is the startup state: no image model is selected or loaded, so its memory stays
# free for the LLM and macOS. Pick a model in the UI to load it (it stays loaded for repeated images);
# pick NONE to unload it. The UI selection is runtime-only and is not saved here, so a restart always
# comes back on none. Setting a style here selects it at startup but still loads it only on first use.
# IMAGE_STYLE_REALISTIC_MODEL=John6666/perfection-realistic-ilxl-illustrious-xl-nsfw-sfw-checkpoint-42-sdxl
# IMAGE_STYLE_REALISTIC_STEPS=24       # a full (non-distilled) SDXL model needs real steps + CFG
# IMAGE_STYLE_REALISTIC_GUIDANCE=5.0
# IMAGE_STYLE_LIGHTNING_MODEL=SG161222/RealVisXL_V4.0_Lightning
# IMAGE_STYLE_LIGHTNING_STEPS=6
# IMAGE_STYLE_LIGHTNING_GUIDANCE=1.0
# IMAGE_STYLE_REALVIS5_MODEL=SG161222/RealVisXL_V5.0
# IMAGE_STYLE_REALVIS5_STEPS=25        # loaded with DPM++ 2M Karras, as its model card recommends
# IMAGE_STYLE_REALVIS5_GUIDANCE=5.0
#
# IP-Adapter FaceID: "make me an astronaut" with a photo attached makes a NEW image of that person
# (create_image's face_image_id), with any style. Downloads h94/IP-Adapter-FaceID's SDXL adapter (~1.1GB) and
# InsightFace's ArcFace recognition model (~175MB) on first use; the face is found with OpenCV's YuNet
# (models/faceid/). Needs opencv-python and onnxruntime. Both models are for non-commercial use.
# IMAGE_FACEID_ENABLED=true
# IMAGE_FACEID_SCALE=0.8               # how strongly the face steers the image
#
# Square height=width generated at (720 or 1024 only) - independent of style, switchable at runtime
# from a button in the UI (no restart, no model reload - just a number read at the start of the next
# generation). Was previously unset entirely (create_image/edit_image never passed height/width to
# the pipeline at all), so every image silently ran at diffusers' own default of 1024 - the dominant
# real cost in every generation measured this session. 720 is ~49% of 1024's pixel count (roughly
# that much less UNet/VAE compute), real measured result: 62.5s vs 125.8s for the same prompt, ~2x
# faster, no meaningful visible quality loss. A third option above 1024 (2048, then 1536) was built
# and actually tested, not just assumed to work - both produced real, reproduced duplication
# artifacts (this model family pushed past its native training resolution) and were dropped - see
# README "Image generation" for the real tested images.
# IMAGE_RESOLUTION=720
#
# edit_image (img2img - upload a photo, ask for a change): shares REALISTIC's model/steps/guidance
# (see above - edit_image always uses REALISTIC regardless of create_image's style), no separate
# enable flag. strength is edit's own knob - measured for real, low values barely change
# the image at all - this is the real, verified-working value (apples on a table -> blue crystal
# gems on the same table).
# IMAGE_EDIT_STRENGTH=0.9
#
# Optional content filter for edit_image specifically (uploading a REAL photo and asking for a
# sexual edit is a different risk than from-scratch generation - non-consensual intimate imagery of
# an identifiable person). Off by default, by explicit user request - this is your local/private
# tool. Turn on and adjust the term list if you want it:
# IMAGE_EDIT_CONTENT_FILTER_ENABLED=false
# IMAGE_EDIT_BLOCKED_TERMS=nude,naked,nsfw,explicit,sexual,porn,pornographic,topless,undress,strip,lingerie,fetish,erotic
#
#
# --- Video generation: local text-to-video with Wan 2.1 1.3B (off by default, like images) ---
# The video model starts on "none" (nothing loaded); pick Wan 2.1 1.3B in the UI to load it (~13s) and it stays
# loaded for every following video; pick none to unload it. The UI selection is runtime-only and never written
# here. First use downloads ~17.6GB (transformer/VAE ~6GB + the 11.4GB text encoder). Measured on a 16GB M4 Air:
# ~42s per denoising step at 576x320 with 33 frames, so the defaults below (a ~2s clip) take about 15 minutes.
# Frames must be 4k+1 and sizes multiples of 16 (rounded down if not). Bigger is much slower: 832x480x33 frames
# measured 117s/step (about 50 minutes per clip); 480p-class output is not practical on this machine.
# VIDEO_GENERATION_ENABLED=false
# VIDEO_WIDTH=576
# VIDEO_HEIGHT=320
# VIDEO_FRAMES=49                # frames per piece (4k+1); longer videos are several continued pieces
# VIDEO_OVERLAP_FRAMES=9         # each piece continues from the previous piece's last N frames
# VIDEO_DEFAULT_SECONDS=8         # length when the request names none
# VIDEO_MAX_SECONDS=30            # never longer than this ("1 minute" gives 30)
# VIDEO_MODEL=none                # none | wan | ltx - selected at startup (never loaded at startup)
#
# LTX-Video 2B distilled (the LTX 2B button): much faster than Wan, lower detail. ~16GB first download
# (the 6.3GB model file + the 9.8GB fp16 T5-XXL text encoder). Pieces of 8k+1 frames at 24 fps.
# VIDEO_LTX_WIDTH=576
# VIDEO_LTX_HEIGHT=320            # multiples of 32
# VIDEO_LTX_FRAMES=121            # frames per piece (~5s at 24 fps)
# VIDEO_LTX_OVERLAP_FRAMES=9      # each piece continues from the previous piece's last N frames (8k+1)
# VIDEO_LTX_FPS=24
# VIDEO_FPS=16
# VIDEO_STEPS=16
# VIDEO_GUIDANCE_SCALE=5.0
# VIDEO_FLOW_SHIFT=3.0            # Wan's recommendation for 480p-class output
# VIDEO_DTYPE=bfloat16            # or float16 (measured the same speed here)
# VIDEO_GENERATION_TIMEOUT=3600
# VIDEO_MODEL=none                # none | wan - which is selected at startup (never loaded at startup)
#
# NOT covered by the flag above, and NOT configurable anywhere in this codebase, for any user, under
# any setting: a separate check in app/tools/image_safety.py blocks any prompt (create_image or
# edit_image) that combines a reference to a minor with sexual/explicit content. There is no
# environment variable that disables this - by explicit user request: "no exception for minor one."
#
# Uploads for edit_image are saved under UPLOADS_DIR, sandboxed the same way EXPORTS_DIR is:
# UPLOADS_DIR=data/uploads
# UPLOAD_MAX_BYTES=15000000

# --- Logging ---
# LOG_LEVEL=INFO

# --- Future robot link (not implemented yet) ---
# ROBOT_ENABLED=false
# ROBOT_URL=ws://raspberrypi.local:9000/ws
